# =================================
# GiaoTrinh AI - Environment Variables
# =================================

# App Settings
APP_NAME="GiaoTrinh AI - Hỗ trợ Giáo viên"
APP_VERSION="1.0.0"
DEBUG=false

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/giaotrinh_db

# Gemini AI API
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MODEL_SIMPLE=gemini-1.5-flash-8b

# AI Generation Settings
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=8192

# JWT Authentication
# Tạo secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting (requests/minute)
RATE_LIMIT_FREE=5
RATE_LIMIT_BASIC=30
RATE_LIMIT_PREMIUM=100
RATE_LIMIT_ENTERPRISE=500

# File Paths
TEMPLATE_DIR=templates
OUTPUT_DIR=outputs
REFERENCE_DOCX=templates/reference.docx

# Quota (documents/month)
QUOTA_FREE=10
QUOTA_BASIC=100
QUOTA_PREMIUM=500
QUOTA_ENTERPRISE=5000
